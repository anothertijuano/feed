<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent template. Replace /Users/USERNAME with your home
  directory (launchd does NOT expand ~) and adjust the flags. Then:

    cp com.anothertijuano.feed.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.anothertijuano.feed.plist

  NOTE: keep the log files AND the -data/-htpasswd paths on the internal
  disk. launchd refuses to spawn jobs whose logs live on an external
  volume, and macOS TCC can silently block or deny a launchd job's access
  to removable volumes. When upgrading, replace the binary via rm + copy
  or temp file + mv — never overwrite it in place while running.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anothertijuano.feed</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/go/bin/feed</string>
        <string>-data</string>
        <string>/Users/USERNAME/srv/feed/data</string>
        <string>-htpasswd</string>
        <string>/Users/USERNAME/srv/feed/htpasswd</string>
        <string>-addr</string>
        <string>:8084</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/com.anothertijuano.feed.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/com.anothertijuano.feed.log</string>
</dict>
</plist>
